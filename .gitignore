# --- 13. System Logs & Runtime Cache ---
*.log
logs/
!/sys/logs/
!/sys/logs/**
/sys/logs/issues/colab-*.md

# Per-machine Flow identity; never sync another machine profile.
/sys/experiments/b2_illustrator/machine.*.json
/sys/experiments/b2_illustrator/machine.local.json
/sys/experiments/b2_illustrator/results/

# --- 14. Pipeline Conveyor Proofs & Reports ---
/sys/logs/proofs/
/sys/reports/
.worktrees/

# Runtime state accidentally placed alongside blueprint source remains local.
/sys/blueprints/**/brief-current.json
/sys/blueprints/**/execution-control.json
/sys/blueprints/**/integrity.json
/sys/blueprints/**/integrity-meta.json
/sys/blueprints/**/workflow.json

# Per-machine account audits and local activation/cleanup proofs.
/sys/logs/colab-account-audit-*.json
/sys/logs/colab-auto-pool-activation-*.json
/sys/logs/colab-scheduler-live-lock-proof-*.json
/sys/logs/colab-test-isolation-cleanup-*.json

# --- 15. Local Channel Identity Maps, Provisioning Scripts & QA Screenshots ---
/qa/
sys/channels/youtube_channel_map.json
sys/channels/dashboard_metrics.json
sys/channels/dashboard_history.jsonl
sys/tools/provision_wave*.py
sys/tools/setup_wave*.py
sys/tools/cleanup_youtube_channels.py
sys/colab_bridge/accounts/

# Auto-generated high-density long plans (synthesized on-demand by vn_long_high_density_planner.py)
sys/channels/vn_rebuilt_style_specs/*/*_long_high_density_plan.json

# Channel spec dir: whitelist policy. Everything generated/runtime-mutated is ignored;
# all specs (incl. *_rebuilt_spec.json) are tool-generated; only .py/.md tracked.
sys/channels/vn_rebuilt_style_specs/**/*
!sys/channels/vn_rebuilt_style_specs/*.py
!sys/channels/vn_rebuilt_style_specs/*.md

# Channel brand images regenerated by tools (avatar/logo/watermark).
/sys/assets/channels/*/*.png
/sys/channels/*/assets/
