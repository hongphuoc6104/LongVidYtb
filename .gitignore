/sys/assets/voices/**/sample.wav
/sys/assets/voices/**/audition_*.wav
/sys/assets/voices/**/audition-report.json
/sys/assets/voices/**/backup_original/
/sys/assets/voices/adam-bua*
/sys/assets/channels/*/*.png

# --- 5. Logs & issue logbook (auto-written by pilot.py / colab client) ---
*.log
logs/
!/sys/logs/
!/sys/logs/**
/sys/logs/**/*.log
/sys/logs/proofs/
/sys/logs/issues/*
!/sys/logs/issues/README.md
