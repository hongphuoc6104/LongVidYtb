# Video Pilot .gitignore
# Policy: commit reusable engine code, tests, docs and curated assets only.
# Anything generated, per-run, per-machine or one-off stays local.
# Order matters: later rules override earlier ones (re-ignores come after re-includes).

# --- 1. Job outputs, runs & scratch ---
/video/
/sys/runs/
runs/
_work_short/
_work_long/
_tts_work/
clips/
frames/
images/
exports/
scratch/
out/
output/
renders/
artifacts/
bundle/
batches/
build/
build_*/
dist/
tmp/
temp/
.tmp/
/experiments/
/qa/
/sys/staging/
/sys/maintenance/
/sys/research/evidence/
/sys/reports/
.worktrees/
*.tmp
*.png.tmp
*.bak
*.bak_*
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.iso
/*REQUEST*.md

# --- 2. One-off agent scripts (put new ones in sys/scratch/; see AGENTS.md §6) ---
/sys/tools/batch[0-9]*_*.py
/sys/tools/*_worker[0-9]*.py
/sys/tools/rebuild_worker*.py
/sys/tools/channel_data_*.py
/sys/tools/run_*_image_gen.py
/sys/tools/verify_batch*.py
/sys/tools/*_batch[0-9]*_*.py
/sys/tools/provision_wave*.py
/sys/tools/setup_wave*.py
/sys/tools/cleanup_youtube_channels.py
/sys/tools/specs_group_*/
/sys/tools/explainer_generators/
/sys/tools/explainer_specs/

# --- 3. Generated channel specs, plans & brand images ---
sys/channels/vn_rebuilt_style_specs/**/*
!sys/channels/vn_rebuilt_style_specs/*.py
!sys/channels/vn_rebuilt_style_specs/*.md
/sys/assets/channels/*/*.png
/sys/channels/*/assets/
/sys/channels/analytics_*/
sys/channels/youtube_channel_map.json
sys/channels/dashboard_metrics.json
sys/channels/dashboard_history.jsonl
/sys/blueprints/**/brief-current.json
/sys/blueprints/**/execution-control.json
/sys/blueprints/**/integrity.json
/sys/blueprints/**/integrity-meta.json
/sys/blueprints/**/workflow.json

# --- 4. Media (only curated sys/assets/ may be tracked) ---
*.wav
*.mp4
*.mov
*.mkv
