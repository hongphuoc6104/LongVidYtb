#!/usr/bin/env python3
"""Video Pilot — Pipeline Conveyor CLI Launcher.

Entry point for the 6-station No-Mistake development and production pipeline.
Implementation lives in sys/scripts/conveyor.py.
"""
import os
from pathlib import Path
import runpy
import sys

SYSTEM = Path(__file__).resolve().parent / "sys"
venv_py = SYSTEM / ".venv" / "bin" / "python"
if __name__ == "__main__" and venv_py.is_file() and Path(sys.executable).resolve() != venv_py.resolve():
    os.execv(str(venv_py), [str(venv_py), str(Path(__file__).resolve())] + sys.argv[1:])

sys.path.insert(0, str(SYSTEM))
sys.path.insert(0, str(SYSTEM.parent))
# Keep runtime bytecode out of the project root.
sys.pycache_prefix = str(SYSTEM / ".cache" / "pycache")

if __name__ == "__main__":
    runpy.run_path(str(SYSTEM / "scripts/conveyor.py"), run_name="__main__")
