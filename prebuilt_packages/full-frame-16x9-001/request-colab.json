{
  "version": 1,
  "items": [
    {
      "text": "Trang sách vàng kín, đầu bạn vẫn trống.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00000"
    },
    {
      "text": "Bạn gạch thêm một dòng.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00001"
    },
    {
      "text": "Rồi khép giáo trình lại.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00002"
    },
    {
      "text": "Ngòi bút dừng lơ lửng.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00003"
    },
    {
      "text": "Chỉ còn trang giấy trắng.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00004"
    },
    {
      "text": "Bạn định viết gì?",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00005"
    },
    {
      "text": "Định nghĩa vừa đọc biến mất.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00006"
    },
    {
      "text": "Mở sách, mọi câu lại quen.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00007"
    },
    {
      "text": "Chuyện gì vừa xảy ra giữa hai lần mở sách?",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00008"
    },
    {
      "text": "Trong lớp, bạn nhận ra ngay lời giải trên bảng.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00009"
    },
    {
      "text": "Đến lượt đứng lên, câu đầu tiên lại mắc kẹt.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00010"
    },
    {
      "text": "Cả lớp im lặng, chiếc bút vẫn nằm trong tay.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00011"
    },
    {
      "text": "Trang sách quen thuộc không còn ở trước mắt bạn.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00012"
    },
    {
      "text": "Điều biến mất có thể chính là chiếc nạng gợi ý.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00013"
    },
    {
      "text": "Nhận ra lời giải khác với tự dựng lại nó.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00014"
    },
    {
      "text": "Muốn phân biệt, ta cần một phép so sánh công bằng.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00015"
    },
    {
      "text": "Hai nhóm cùng bắt đầu bằng một đoạn văn ngắn.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00016"
    },
    {
      "text": "Nhóm bên trái có thêm lượt đọc lại tài liệu.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00017"
    },
    {
      "text": "Nhóm bên phải tự nhớ lại, khi trang giấy đã khuất.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00018"
    },
    {
      "text": "Câu hỏi không phải ai thấy việc học dễ hơn.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00019"
    },
    {
      "text": "Ta muốn biết điều gì còn lại sau khi chờ.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00020"
    },
    {
      "text": "Nếu kiểm tra ngay, kết quả có thể đánh lừa bạn.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00021"
    },
    {
      "text": "Khoảng cách thời gian sẽ làm hai đường tách ra.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00022"
    },
    {
      "text": "Lần kiểm tra diễn ra sau năm phút, hai ngày, hoặc một tuần.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00023"
    },
    {
      "text": "Cùng một cách học được nhìn qua những cửa sổ khác nhau.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00024"
    },
    {
      "text": "Chiếc đồng hồ không chỉ làm dài thêm buổi chờ.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00025"
    },
    {
      "text": "Nó đổi câu hỏi từ vừa nhìn thấy sang còn nhớ gì.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00026"
    },
    {
      "text": "Bài kiểm tra ngắn hạn chưa nói hết chuyện dài hạn.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00027"
    },
    {
      "text": "Một người có thể thắng ở mốc này, thua ở mốc khác.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00028"
    },
    {
      "text": "Bởi vậy, cảm giác trôi chảy cần được kiểm tra lại.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00029"
    },
    {
      "text": "Sau năm phút, nhóm đọc lại nhớ tốt hơn nhóm tự kiểm tra.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00030"
    },
    {
      "text": "Đây là đoạn kết mà cảm giác dễ chịu muốn giữ lại.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00031"
    },
    {
      "text": "Vừa đọc xong, hình dáng câu chữ vẫn còn rất gần.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00032"
    },
    {
      "text": "Một bài kiểm tra ngay có thể ghi nhận lợi thế ấy.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00033"
    },
    {
      "text": "Nhưng đề thi thật thường không nằm ngay cuối trang.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00034"
    },
    {
      "text": "Bạn phải mang kiến thức đi qua một khoảng thời gian.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00035"
    },
    {
      "text": "Phép so sánh vì thế chưa thể dừng ở đây.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00036"
    },
    {
      "text": "Ở các lần kiểm tra muộn, nhóm từng tự kiểm tra nhớ tốt hơn.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00037"
    },
    {
      "text": "Thứ hạng đổi chỗ, dù đoạn văn ban đầu vẫn giống nhau.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00038"
    },
    {
      "text": "Đường dễ đi lúc học không đảm bảo lợi thế về sau.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00039"
    },
    {
      "text": "Đường phải tự tìm lại có thể giúp ở lần nhớ kế tiếp.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00040"
    },
    {
      "text": "Đừng biến kết quả này thành lời cấm mọi lượt đọc lại.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00041"
    },
    {
      "text": "Thí nghiệm đang so sánh những điều kiện cụ thể của nó.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00042"
    },
    {
      "text": "Nó đủ để hỏi lại cách ta đánh giá buổi học.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00043"
    },
    {
      "text": "Đọc lại còn làm người học tự tin hơn vào khả năng nhớ.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00044"
    },
    {
      "text": "Chiếc kim tự tin và chồng câu trả lời không luôn đi cùng.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00045"
    },
    {
      "text": "Một cảm giác rất thật vẫn có thể là thước đo lệch.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00046"
    },
    {
      "text": "Bạn không bịa ra sự quen thuộc của trang sách.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00047"
    },
    {
      "text": "Vấn đề nằm ở điều bạn suy ra từ cảm giác đó.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00048"
    },
    {
      "text": "Từ quen mắt đến nhớ được còn có một bước chưa thử.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00049"
    },
    {
      "text": "Ta cần nhìn rõ bước bị bỏ qua trong lần tự nhớ ấy.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00050"
    },
    {
      "text": "Trên bản đồ có sẵn, mọi ngã rẽ trông rất rõ.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00051"
    },
    {
      "text": "Khi bản đồ bị che, bạn phải tự chọn đường đi.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00052"
    },
    {
      "text": "Biết nhìn tuyến đường không đồng nghĩa nhớ từng chỗ rẽ.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00053"
    },
    {
      "text": "Một khúc cua quên mất đủ làm hành trình đứt đoạn.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00054"
    },
    {
      "text": "Đây là hình dung cho khác biệt giữa hai nhiệm vụ.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00055"
    },
    {
      "text": "Nó không phải ảnh chụp một vùng não đang hoạt động.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00056"
    },
    {
      "text": "Ẩn dụ giúp ta thấy chỗ cần kiểm tra.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00057"
    },
    {
      "text": "Bạn nhìn cây cầu hoàn chỉnh và hiểu cách nó nối bờ.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00058"
    },
    {
      "text": "Tự dựng cầu lại buộc bạn đặt từng nhịp đúng chỗ.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00059"
    },
    {
      "text": "Một thanh còn thiếu làm lộ ra phần chưa chắc chắn.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00060"
    },
    {
      "text": "Nhìn lâu thêm vào cầu không tự chứng minh bạn dựng được.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00061"
    },
    {
      "text": "Hai việc có thể cùng cần, nhưng kiểm tra khác nhau.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00062"
    },
    {
      "text": "Câu hỏi tốt chỉ đúng vào nhịp cầu đang thiếu.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00063"
    },
    {
      "text": "Nó nhỏ hơn lời phán xét rằng bạn chẳng hiểu gì.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00064"
    },
    {
      "text": "Một câu hỏi đưa sẵn từ khóa giống cánh cửa mở.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00065"
    },
    {
      "text": "Bạn có thể bước theo lối đó mà ít phải tự tìm.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00066"
    },
    {
      "text": "Khi đổi cách hỏi, cánh cửa quen có thể không còn.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00067"
    },
    {
      "text": "Lúc ấy, điều cần thử là đường đi tới ý chính.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00068"
    },
    {
      "text": "Nhà kho này chỉ là ẩn dụ để thấy nhiệm vụ.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00069"
    },
    {
      "text": "Ta không gán mỗi chiếc ngăn cho một vùng não riêng.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00070"
    },
    {
      "text": "Đừng biến một bức hình dễ nhớ thành bằng chứng sinh học.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00071"
    },
    {
      "text": "Trong xưởng, chỗ cầu bị hở cho người thợ một thông tin.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00072"
    },
    {
      "text": "Nó cho biết thanh nào chưa được đặt đúng vị trí.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00073"
    },
    {
      "text": "Một câu trả lời thiếu cũng có thể chỉ rõ lỗ hổng.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00074"
    },
    {
      "text": "Điều hữu ích là khoảng trống cụ thể, không phải cảm giác thua.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00075"
    },
    {
      "text": "Nếu chỉ nhìn điểm tổng, bạn có thể bỏ qua chi tiết đó.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00076"
    },
    {
      "text": "Nếu chỉ đọc lại mọi thứ, bạn lại mất dấu chỗ cần sửa.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00077"
    },
    {
      "text": "Độ chính xác của câu hỏi sẽ quyết định bước tiếp theo.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00078"
    },
    {
      "text": "Thí nghiệm dùng đoạn văn, với điều kiện được thiết kế.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00079"
    },
    {
      "text": "Nó không hứa mọi môn học đều tăng đúng một mức.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00080"
    },
    {
      "text": "Cũng không cho ta một con số mất trí nhớ chung cho mọi người.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00081"
    },
    {
      "text": "Từ kết quả ấy, ta rút ra một câu hỏi có ích.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00082"
    },
    {
      "text": "Buổi học đang luyện nhìn đáp án hay tự gọi lại ý?",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00083"
    },
    {
      "text": "Câu hỏi này cụ thể hơn lời khuyên phải cố thêm.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00084"
    },
    {
      "text": "Nó cũng mở đường cho cách đọc tài liệu khó.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00085"
    },
    {
      "text": "Bạn đọc một bài báo, gật đầu qua từng đoạn lập luận.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00086"
    },
    {
      "text": "Những từ quen thuộc khiến trang giấy có vẻ rất dễ hiểu.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00087"
    },
    {
      "text": "Nhưng vấn đề nghiên cứu và kết luận chưa chắc đã nối được.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00088"
    },
    {
      "text": "Đổi sang kể lại câu hỏi sẽ làm rõ điều còn thiếu.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00089"
    },
    {
      "text": "Đích đến không phải chép lại tên từng mục của bài.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00090"
    },
    {
      "text": "Điều cần có là quan hệ giữa dữ liệu và kết luận.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00091"
    },
    {
      "text": "Một sơ đồ ngắn có thể làm lộ đoạn nối còn mơ hồ.",
      "language": "vi",
      "retake": 0,
      "speed": 1.0,
      "id": "u00092"
    },
    {
      "text": "Trước hội đồng, câu hỏi thường đổi cách diễn đạt quen thuộc.",
      "language": "vi",
      "retake": 0,
